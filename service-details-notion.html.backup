<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>R+ Tainá | Template Notion para Médicos - Sophos Academy</title>
  <meta name="description" content="R+ Tainá - Assistente Inteligente no Notion para organização de estudos médicos e revisões semanais. Sistema completo para subespecializações.">
  <meta name="keywords" content="notion template médico, organização estudos médicos, assistente médico notion, template residência médica, R+ subespecialização">

  <!-- Favicons -->
  <link href="assets/img/favicon.png" rel="icon">
  <link href="assets/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="assets/vendor/aos/aos.css" rel="stylesheet">
  <link href="assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
  <link href="assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="assets/css/main.css" rel="stylesheet">

  <!-- Antes do fechamento da head -->
  <link rel="stylesheet" href="assets/css/style-mentoria.css">
  
  <style>
    /* Estilos específicos para a página R+ Tainá */
    .notion-header {
      background: linear-gradient(135deg, #f0f0f0 0%, #e6e6e6 100%);
      border-radius: 8px;
      padding: 20px;
      margin-bottom: 30px;
    }
    
    .notion-badge {
      background-color: #2383E2;
      color: white;
      font-weight: 600;
      padding: 8px 16px;
      border-radius: 20px;
      display: inline-block;
      margin-bottom: 15px;
    }
    
    .notion-feature-card {
      background-color: white;
      border-radius: 8px;
      padding: 25px;
      box-shadow: 0 2px 15px rgba(0, 0, 0, 0.05);
      height: 100%;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .notion-feature-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.1);
    }
    
    .notion-feature-icon {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background-color: #f2f7ff;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }
    
    .notion-feature-icon i {
      font-size: 28px;
      color: #2383E2;
    }
    
    .notion-dashboard-preview {
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
      margin: 30px 0;
    }
    
    .notion-dashboard-preview img {
      width: 100%;
      height: auto;
      transition: transform 0.5s ease;
    }
    
    .notion-dashboard-preview:hover img {
      transform: scale(1.02);
    }
    
    .notion-timeline {
      position: relative;
      padding-left: 40px;
    }
    
    .notion-timeline::before {
      content: "";
      position: absolute;
      left: 10px;
      top: 0;
      bottom: 0;
      width: 2px;
      background-color: #e0e0e0;
    }
    
    .notion-timeline-item {
      position: relative;
      margin-bottom: 30px;
    }
    
    .notion-timeline-item::before {
      content: "";
      position: absolute;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background-color: #2383E2;
      left: -40px;
      top: 5px;
    }
    
    .template-notion .service-hero-container {
      padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
      position: relative;
      overflow: hidden;
      border-radius: 10px;
    }
    
    .template-notion .service-hero-container iframe {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: none;
    }
    
    .template-notion .service-hero-overlay {
      background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.7));
    }
    
    /* Estilos para seção de depoimentos (Testimonials) */
    .testimonials-section {
      padding: 20px 0;
    }
    
    .testimonial-card {
      background-color: #fff;
      border-radius: 12px;
      padding: 30px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
      height: 100%;
      position: relative;
      transition: all 0.3s ease;
    }
    
    .testimonial-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
    }
    
    .testimonial-card.featured-testimonial {
      background: linear-gradient(135deg, #f8f9fa, #e9f5ff);
      border-left: 4px solid #2563EB;
    }
    
    .testimonial-quote {
      position: absolute;
      top: 15px;
      right: 20px;
      font-size: 40px;
      color: rgba(37, 99, 235, 0.1);
    }
    
    .testimonial-content {
      margin-bottom: 20px;
      font-style: italic;
      color: #4B5563;
      position: relative;
      z-index: 1;
    }
    
    .testimonial-content p {
      font-size: 16px;
      line-height: 1.6;
    }
    
    .author-image {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      overflow: hidden;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
    }
    
    .testimonial-author {
      margin-top: auto;
    }
    
    .author-info h5 {
      font-size: 18px;
      color: #111827;
      margin-bottom: 2px;
    }
    
    .rating {
      color: #FFB800;
      font-size: 14px;
      margin-top: 5px;
    }
    
    /* Estilos para o depoimento em vídeo */
    .video-testimonial {
      background-color: #f8f9fa;
      border-radius: 12px;
      padding: 30px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }
    
    .video-container {
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }
    
    .video-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease;
      cursor: pointer;
    }
    
    .video-overlay:hover {
      background: rgba(0, 0, 0, 0.2);
    }
    
    .play-button i {
      font-size: 60px;
      color: white;
      opacity: 0.9;
      transition: all 0.3s ease;
    }
    
    .video-overlay:hover .play-button i {
      transform: scale(1.1);
      opacity: 1;
    }
    
    .video-testimonial-content h4 {
      color: #111827;
      font-size: 24px;
      margin-bottom: 15px;
    }
    
    .video-testimonial-content .lead {
      color: #2563EB;
      font-style: italic;
      font-weight: 500;
      margin-bottom: 15px;
    }
    
    .author-credentials img {
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
    }
    
    .cta-guarantee {
      margin-top: 15px;
      color: rgba(255, 255, 255, 0.8);
    }

    .final-cta-section .btn-primary {
      background-color: white;
      color: #2563EB;
      border: none;
      font-weight: 600;
      transition: all 0.3s ease;
    }

    .final-cta-section .btn-primary:hover {
      transform: scale(1.05);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
    }
    
    /* Responsividade */
    @media (max-width: 992px) {
      .pricing-card.featured {
        transform: scale(1);
        margin-top: 20px;
        margin-bottom: 20px;
      }
  </style>
</head>

