  <!-- Estilos específicos para a página Liberdade para Criar -->
  <style>
    .template-criar .service-hero-container {
      position: relative;
      overflow: hidden;
      border-radius: 15px;
    }
    
    .template-criar .creative-element {
      transition: all 0.4s ease;
      transform-origin: center;
    }
    
    .template-criar .creative-element:hover {
      transform: scale(1.05);
    }
    
    .creative-canvas {
      background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 30px;
      border: 1px solid rgba(255,255,255,0.2);
      box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    }
    
    .floating-element {
      animation: float 6s ease-in-out infinite;
    }
    
    @keyframes float {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-15px); }
      100% { transform: translateY(0px); }
    }
    
    .template-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      z-index: 1;
    }
    
    .template-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }
    
    .template-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, rgba(79,172,254,0.1) 0%, rgba(0,242,254,0.1) 100%);
      z-index: -1;
      transition: all 0.5s ease;
    }
    
    .template-card:hover::before {
      transform: scale(1.1);
    }
    
    .drag-indicator {
      color: #6c757d;
      font-size: 1.5rem;
      margin-right: 10px;
      cursor: move;
    }
    
    .brain-map {
      position: relative;
      min-height: 400px;
      background: #f8f9fa;
      border-radius: 20px;
      padding: 20px;
      margin-bottom: 30px;
    }
    
    .node {
      position: absolute;
      background: #fff;
      padding: 10px 15px;
      border-radius: 50px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .node:hover {
      transform: scale(1.1);
      box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
    
    .node-1 {
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: #4361ee;
      color: white;
      padding: 15px 25px;
      z-index: 10;
    }
    
    .node-2 {
      top: 30%;
      left: 30%;
      background: #f72585;
      color: white;
    }
    
    .node-3 {
      top: 30%;
      right: 30%;
      background: #7209b7;
      color: white;
    }
    
    .node-4 {
      bottom: 30%;
      left: 30%;
      background: #3a0ca3;
      color: white;
    }
    
    .node-5 {
      bottom: 30%;
      right: 30%;
      background: #4cc9f0;
      color: white;
    }
    
    .connection {
      position: absolute;
      background: #e9ecef;
      height: 2px;
      z-index: 1;
    }
    
    .glow-effect {
      position: relative;
    }
    
    .glow-effect::before {
      content: '';
      position: absolute;
      top: -3px;
      left: -3px;
      right: -3px;
      bottom: -3px;
      border-radius: inherit;
      background: linear-gradient(45deg, #ff0099, #00ff99, #0099ff, #9900ff);
      z-index: -1;
      animation: glowing 5s linear infinite;
      opacity: 0;
      transition: opacity 0.3s ease-in-out;
    }
    
    .glow-effect:hover::before {
      opacity: 1;
    }
    
    @keyframes glowing {
      0% { background-position: 0 0; }
      50% { background-position: 400% 0; }
      100% { background-position: 0 0; }
    }
    
    .creative-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 25px;
    }
    
    .feature-card {
      background: white;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.05);
      padding: 30px;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    
    .feature-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    
    .feature-icon-circle {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      font-size: 2rem;
      transition: all 0.3s ease;
    }
    
    .feature-card:hover .feature-icon-circle {
      transform: rotateY(180deg);
    }
    
    .purple-gradient {
      background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
      color: white;
    }
    
    .green-gradient {
      background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
      color: white;
    }
    
    .blue-gradient {
      background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
      color: white;
    }
    
    .orange-gradient {
      background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
      color: white;
    }
  </style>
</head>

