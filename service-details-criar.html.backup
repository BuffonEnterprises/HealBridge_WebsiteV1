              <div class="node node-3">Recursos Visuais</div>
              <div class="node node-4">Mapas Mentais</div>
              <div class="node node-5">Flashcards</div>
              
              <div class="connection" style="width: 100px; transform: rotate(45deg); top: 40%; left: 37%;"></div>
              <div class="connection" style="width: 100px; transform: rotate(-45deg); top: 40%; right: 37%;"></div>
              <div class="connection" style="width: 100px; transform: rotate(-45deg); bottom: 40%; left: 37%;"></div>
              <div class="connection" style="width: 100px; transform: rotate(45deg); bottom: 40%; right: 37%;"></div>
            </div>
            
            <!-- Main Features Section with Creative Grid -->
            <div class="features-section mb-5">
              <h3 class="text-center mb-2">Blocos de Construção</h3>
              <p class="text-center mb-5">Combine estes elementos poderosos para criar seu sistema de estudo personalizado</p>
              
              <div class="creative-grid">
                <div class="feature-card creative-element">
                  <div class="feature-icon-circle purple-gradient">
                    <i class="bi bi-layers"></i>
                  </div>
                  <h4>Templates Flexíveis</h4>
