                                      <div class="stage-icon mb-3">
                                        <i class="bi bi-4-circle-fill fs-1 text-primary"></i>
                                      </div>
                                      <h5>Maestria</h5>
                                      <p class="small">Domine seu sistema e maximize seus resultados</p>
                                    </div>
                                  </div>
                                </div>
                              </div>
                              
                              <!-- Testimonials Section with Slider -->
                              <div class="testimonials-section mb-5">
                                <h3 class="text-center mb-4">Histórias de Sucesso</h3>
                                
                                <div class="swiper testimonial-swiper">
                                  <div class="swiper-wrapper">
                                    <div class="swiper-slide">
