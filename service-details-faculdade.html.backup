<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Projeto Faculdade - Sophos Academy | Plataforma Educacional Médica</title>
  <meta name="description" content="Projeto Faculdade - Sistema completo para organização de estudos médicos na graduação, com recursos especializados para disciplinas básicas e clínicas">
  <meta name="keywords" content="medicina, faculdade, graduação médica, estudos médicos, organização, método de estudo médico">

  <!-- Favicons -->
  <link href="assets/img/favicon.png" rel="icon">
  <link href="assets/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="assets/vendor/aos/aos.css" rel="stylesheet">
  <link href="assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
  <link href="assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="assets/css/main.css" rel="stylesheet">

  <!-- Antes do fechamento da head -->
  <link rel="stylesheet" href="assets/css/style-mentoria.css">

  <!-- Estilos específicos para a página Liberdade para Criar -->
  <style>
    .template-criar .service-hero-container {
      position: relative;
      overflow: hidden;
      border-radius: 15px;
    }
    
    .template-criar .creative-element {
      transition: all 0.4s ease;
      transform-origin: center;
    }
    
    .template-criar .creative-element:hover {
      transform: scale(1.05);
    }
    
    .creative-canvas {
      background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 30px;
      border: 1px solid rgba(255,255,255,0.2);
      box-shadow: 0 8px 32px rgba(0,0,0,0.1);
    }
    
    .floating-element {
      animation: float 6s ease-in-out infinite;
    }
    
    @keyframes float {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-15px); }
      100% { transform: translateY(0px); }
    }
    
    .template-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      z-index: 1;
    }
    
    .template-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }
    
    .template-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, rgba(79,172,254,0.1) 0%, rgba(0,242,254,0.1) 100%);
      z-index: -1;
      transition: all 0.5s ease;
    }
    
    .template-card:hover::before {
      transform: scale(1.1);
    }
    
    .drag-indicator {
      color: #6c757d;
      font-size: 1.5rem;
      margin-right: 10px;
      cursor: move;
    }
    
    .brain-map {
      position: relative;
      min-height: 400px;
      background: #f8f9fa;
      border-radius: 20px;
      padding: 20px;
      margin-bottom: 30px;
    }
    
    .node {
      position: absolute;
      background: #fff;
      padding: 10px 15px;
      border-radius: 50px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .node:hover {
      transform: scale(1.1);
      box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
    
    .node-1 {
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: #4361ee;
      color: white;
      padding: 15px 25px;
      z-index: 10;
    }
    
    .node-2 {
      top: 30%;
      left: 30%;
      background: #f72585;
      color: white;
    }
    
    .node-3 {
      top: 30%;
      right: 30%;
      background: #7209b7;
      color: white;
    }
    
    .node-4 {
      bottom: 30%;
      left: 30%;
      background: #3a0ca3;
      color: white;
    }
    
    .node-5 {
      bottom: 30%;
      right: 30%;
      background: #4cc9f0;
      color: white;
    }
    
    .connection {
      position: absolute;
      background: #e9ecef;
      height: 2px;
      z-index: 1;
    }
    
    .glow-effect {
      position: relative;
    }
    
    .glow-effect::before {
      content: '';
      position: absolute;
      top: -3px;
      left: -3px;
      right: -3px;
      bottom: -3px;
      border-radius: inherit;
      background: linear-gradient(45deg, #ff0099, #00ff99, #0099ff, #9900ff);
      z-index: -1;
      animation: glowing 5s linear infinite;
      opacity: 0;
      transition: opacity 0.3s ease-in-out;
    }
    
    .glow-effect:hover::before {
      opacity: 1;
    }
    
    @keyframes glowing {
      0% { background-position: 0 0; }
      50% { background-position: 400% 0; }
      100% { background-position: 0 0; }
    }
    
    .creative-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 25px;
    }
    
    .feature-card {
      background: white;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.05);
      padding: 30px;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    
    .feature-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    }
    
    .feature-icon-circle {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
      font-size: 2rem;
      transition: all 0.3s ease;
    }
    
    .feature-card:hover .feature-icon-circle {
      transform: rotateY(180deg);
    }
    
    .purple-gradient {
      background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
      color: white;
    }
    
    .green-gradient {
      background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
      color: white;
    }
    
    .blue-gradient {
      background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
      color: white;
    }
    
    .orange-gradient {
      background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
      color: white;
    }
    
    .curriculum-map {
      position: relative;
      min-height: 400px;
      background: #f8f9fa;
      border-radius: 20px;
      padding: 20px;
      margin-bottom: 30px;
    }
    
    .subject {
      position: absolute;
      background: #fff;
      padding: 10px 15px;
      border-radius: 50px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .subject:hover {
      transform: scale(1.1);
      box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }
    
    .subject-1 {
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      background: #4361ee;
      color: white;
      padding: 15px 25px;
      z-index: 10;
    }
    
    .subject-2 {
      top: 30%;
      left: 30%;
      background: #f72585;
      color: white;
    }
    
    .subject-3 {
      top: 30%;
      right: 30%;
      background: #7209b7;
      color: white;
    }
    
    .subject-4 {
      bottom: 30%;
      left: 30%;
      background: #3a0ca3;
      color: white;
    }
    
    .subject-5 {
      bottom: 30%;
      right: 30%;
      background: #4cc9f0;
      color: white;
    }
    
    .academic-element {
      transition: all 0.4s ease;
      transform-origin: center;
    }
    
    .academic-element:hover {
      transform: scale(1.05);
    }
    
    .anatomy-gradient {
      background: linear-gradient(135deg, #f72585 0%, #7209b7 100%);
      color: white;
    }
    
    .physiology-gradient {
      background: linear-gradient(135deg, #3a0ca3 0%, #4cc9f0 100%);
      color: white;
    }
    
    .biochemistry-gradient {
      background: linear-gradient(135deg, #4361ee 0%, #a78bfa 100%);
      color: white;
    }
    
    .pathology-gradient {
      background: linear-gradient(135deg, #10b981 0%, #34d399 100%);
      color: white;
    }
    
    .semester-section {
      margin-bottom: 50px;
    }
    
    .timeline-container {
      position: relative;
      padding: 20px;
      margin-bottom: 20px;
      border-radius: 10px;
      background-color: #f8f9fa;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    
    .timeline-item {
      margin-bottom: 20px;
    }
    
    .timeline-left {
      text-align: left;
    }
    
    .timeline-right {
      text-align: right;
    }
    
    .timeline-content {
      padding: 20px;
      border-radius: 10px;
      background-color: #fff;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }
    
    .semester-indicator {
      font-size: 1.5rem;
      font-weight: bold;
      margin-right: 10px;
    }
    
    .course-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      padding: 20px;
      transition: all 0.3s ease;
    }
    
    .course-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }
    
    /* Pricing Cards */
    .pricing-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      position: relative;
      transition: all 0.3s ease;
      height: 100%;
    }
    
    .pricing-card:hover {
      transform: translateY(-10px);
      box-shadow: 0 15px 35px rgba(0,0,0,0.15);
    }
    
    .pricing-card.popular {
      border: 2px solid #4361ee;
      z-index: 1;
    }
    
    .pricing-badge {
      position: absolute;
      top: -12px;
      right: 20px;
      background: #4361ee;
      color: white;
      padding: 5px 15px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 600;
    }
    
    .pricing-header {
      padding: 20px 0;
      border-bottom: 1px solid #f0f0f0;
    }
    
    .price {
      font-size: 2.5rem;
      font-weight: 700;
      color: #333;
      margin: 15px 0;
    }
    
    .price small {
      font-size: 1rem;
      color: #888;
    }
    
    /* Testimonial Cards */
    .testimonial-card {
      background: #fff;
      border-radius: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      transition: all 0.3s ease;
      height: 100%;
    }
    
    .testimonial-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(0,0,0,0.15);
    }
    
    .testimonial-avatar img {
      border: 3px solid #4361ee;
      padding: 2px;
    }
    
    .rating {
      margin-top: 15px;
    }
    
    /* Success Stories */
    .success-stories {
      margin-bottom: 50px;
    }
    
    .success-icon {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
    }
    
    /* CTA Section */
    .cta-section {
      background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
      padding: 60px 0;
      border-radius: 20px;
    }
    
    /* Timeline */
    .timeline-container {
      position: relative;
    }
    
    .timeline-container::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 2px;
      background-color: #4361ee;
      transform: translateX(-50%);
    }
    
    .timeline-item {
      margin-bottom: 30px;
      position: relative;
    }
    
    .timeline-left {
      padding-right: 50%;
      text-align: right;
    }
    
    .timeline-right {
      padding-left: 50%;
      text-align: left;
    }
    
    .timeline-content {
      background: white;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
      position: relative;
    }
    
    .timeline-left .timeline-content::after {
      content: '';
      position: absolute;
      right: -10px;
      top: 20px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #4361ee;
    }
    
    .timeline-right .timeline-content::before {
      content: '';
      position: absolute;
      left: -10px;
      top: 20px;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #4361ee;
    }
    
    /* Accordion Styling */
    .accordion-item {
      border-radius: 12px !important;
      overflow: hidden;
      box-shadow: 0 5px 15px rgba(0,0,0,0.05);
      margin-bottom: 15px;
    }
    
    .accordion-button {
      font-weight: 600;
      padding: 20px 25px;
      color: #333;
    }
    
    .accordion-button:not(.collapsed) {
      background-color: #4361ee;
      color: white;
    }
    
    .accordion-button:focus {
      box-shadow: none;
      border-color: rgba(0,0,0,0.125);
    }
    
    .accordion-button:not(.collapsed)::after {
      filter: brightness(0) invert(1);
    }
    
    .accordion-body {
      padding: 20px 25px;
      line-height: 1.7;
    }
  </style>
</head>

