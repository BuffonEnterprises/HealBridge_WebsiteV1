            <div class="service-box">
              <h4>Downloads Disponíveis</h4>
              <div class="download-catalog">
                <a href="#"><i class="bi bi-filetype-pdf"></i><span>Guia de Personalização PDF</span></a>
                <a href="#"><i class="bi bi-file-earmark-ppt"></i><span>Templates Iniciais</span></a>
