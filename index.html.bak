<link href="assets/css/portfolio-details.css" rel="stylesheet"><!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>Sophos Academy - Potencialize seus estudos com IA</title>
  <meta name="description" content="A Sophos Academy é uma plataforma de aprendizado acelerado que utiliza IA para transformar a forma como você aprende e retém informações.">
  <meta name="keywords" content="aprendizado acelerado, revisão espaçada, IA educacional, second brain, gestão de conhecimento">

  <!-- Favicons -->
  <link href="assets/img/favicon.png" rel="icon">
  <link href="assets/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="assets/vendor/aos/aos.css" rel="stylesheet">
  <link href="assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
  <link href="assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="assets/css/main.css" rel="stylesheet">

  <!-- Carousel CSS File -->
  <link href="assets/css/carousel.css" rel="stylesheet">

  <!-- Antes do fechamento da head -->
  <link rel="stylesheet" href="assets/css/style-mentoria.css">
  
  <!-- Estilos adicionais para o tema verde -->
  <style>
    :root {
      --primary-color: #42b983;
      --primary-color-rgb: 66, 185, 131;
      --primary-color-dark: #3aa876;
      --primary-color-light: #5ac596;
      --primary-color-lightrgba: rgba(66, 185, 131, 0.1);
    }
    
    /* Ajustes de cores para o tema verde */
    .btn-primary, 
    .btn-getstarted,
    .badge-primary,
    .badge-info,
    .nav-link.active,
    .icon-box i,
    .scrolled .btn-getstarted {
      background-color: var(--primary-color) !important;
      border-color: var(--primary-color) !important;
    }
    
    a:hover,
    .navmenu a:hover, 
    .navmenu .active, 
    .navmenu .active:focus, 
    .navmenu li:hover > a,
    .icon-box:hover h3 a,
    .features-item i,
    .footer-links a:hover {
      color: var(--primary-color) !important;
    }
    
    .sitename span,
    .service-card .icon i,
    .footer a:hover,
    .about-list i,
    .stats-item i,
    .feature-icon i {
      color: var(--primary-color) !important;
    }
    
    .social-links a:hover,
    .scroll-top:hover,
    .btn-details:hover,
    .cta-btn:hover {
      background: var(--primary-color) !important;
    }
    
    /* Estilos específicos para o carrossel de recursos */
    .feature-swiper-initialized .swiper-wrapper {
      transition-timing-function: cubic-bezier(0.25, 0.46, 0.45, 0.94) !important;
    }
    
    /* Efeito de transição de Slides */
    .feature-card {
      transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94), 
                  opacity 0.6s ease, 
                  box-shadow 0.6s ease !important;
    }
    
    /* Melhorar visualmente a transição entre slides */
    .feature-swiper .swiper-slide-active {
      transform: scale(1) translateY(0);
      z-index: 10;
      opacity: 1;
    }
    
    .feature-swiper .swiper-slide-prev,
    .feature-swiper .swiper-slide-next {
      opacity: 0.85;
      transform: scale(0.9);
      z-index: 9;
    }
    
    .feature-swiper .swiper-slide-prev {
      transform: scale(0.9) translateX(-5%);
    }
    
    .feature-swiper .swiper-slide-next {
      transform: scale(0.9) translateX(5%);
    }
    
    /* Estilos avançados para slides não ativos */
    .feature-swiper .swiper-slide:not(.swiper-slide-active):not(.swiper-slide-prev):not(.swiper-slide-next) {
      opacity: 0.6;
      transform: scale(0.85);
      z-index: 8;
      filter: blur(1px);
    }
    
    /* Efeitos de movimento para melhorar a sensação de fluidez */
    @keyframes slideInFromRight {
      0% {
        transform: translateX(100%) scale(0.85);
        opacity: 0;
      }
      100% {
        transform: translateX(0) scale(1);
        opacity: 1;
      }
    }
    
    @keyframes slideOutToLeft {
      0% {
        transform: translateX(0) scale(1);
        opacity: 1;
      }
      100% {
        transform: translateX(-100%) scale(0.85);
        opacity: 0;
      }
    }
    
    /* Adiciona efeito de perspectiva para melhorar a visualização 3D */
    .feature-swiper {
      perspective: 1000px;
    }
    
    .feature-swiper .swiper-wrapper {
      transform-style: preserve-3d;
    }
    
    /* Melhoria visual para os controles do carrossel */
    .swiper-button-next:after, 
    .swiper-button-prev:after {
      transition: all 0.3s ease;
    }
    
    .swiper-button-next:hover:after, 
    .swiper-button-prev:hover:after {
      transform: scale(1.2);
    }
    
    /* Sobreposição de sombra para destacar o slide ativo */
    .feature-swiper .swiper-slide-active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 5px;
      background: linear-gradient(90deg, transparent, var(--primary-color), transparent);
      opacity: 0.8;
      border-radius: 0 0 15px 15px;
    }
  </style>

</head>

