  <!-- Script personalizado para garantir o funcionamento adequado do carrossel -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Atualiza os swipers quando a janela é redimensionada
      window.addEventListener('resize', function() {
        document.querySelectorAll('.init-swiper').forEach(function(swiperElement) {
          if (swiperElement.swiper) {
            swiperElement.swiper.update();
          }
        });
      });
      
      // Garante que o carrossel de recursos seja atualizado quando se torna visível
      const templateFeatures = document.getElementById('template-features');
      if (templateFeatures) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const swiperElement = templateFeatures.querySelector('.feature-swiper');
              if (swiperElement && swiperElement.swiper) {
                setTimeout(() => {
                  swiperElement.swiper.update();
                  // Reinicia do primeiro slide se estiver no final
                  if (swiperElement.swiper.isEnd) {
                    swiperElement.swiper.slideTo(0, 0, false);
                  }
                  swiperElement.swiper.autoplay.start();
                }, 100);
              }
            } else {
              // Quando não estiver visível, pausar para economizar recursos
              const swiperElement = templateFeatures.querySelector('.feature-swiper');
              if (swiperElement && swiperElement.swiper && swiperElement.swiper.autoplay) {
                swiperElement.swiper.autoplay.stop();
              }
            }
          });
        }, { threshold: 0.25 });
        
        observer.observe(templateFeatures);
      }
      
      // Tratamento especial para o carrossel de recursos
      function setupFeatureCarousel() {
        const featureSwiper = document.querySelector('.feature-swiper');
        if (featureSwiper && featureSwiper.swiper) {
          // Adiciona evento para o final do carrossel
          featureSwiper.swiper.on('reachEnd', function() {
            // Pequeno atraso para evitar efeito visual estranho
            setTimeout(() => {
              // Retorna ao slide inicial com transição suave
              featureSwiper.swiper.slideTo(0, 800, true);
            }, 500);
          });
          
          // Adicionar evento para transições
          featureSwiper.swiper.on('transitionEnd', function() {
            // Garantir que o último slide transicione suavemente para o primeiro
            if (featureSwiper.swiper.isEnd) {
              setTimeout(() => {
                featureSwiper.swiper.slideTo(0, 800, true);
              }, 200);
            }
          });
          
          // Adiciona efeito visual aos slides durante a transição
          featureSwiper.swiper.on('slideChange', function() {
            const slides = featureSwiper.querySelectorAll('.swiper-slide');
            slides.forEach((slide, index) => {
              // Adiciona efeito dependendo da posição do slide
              if (index === featureSwiper.swiper.activeIndex) {
                slide.style.transition = 'all 0.6s ease';
                slide.style.opacity = '1';
                slide.style.transform = 'scale(1)';
                slide.style.filter = 'blur(0)';
                slide.style.zIndex = '10';
              } else if (index === featureSwiper.swiper.activeIndex + 1 || 
                        index === featureSwiper.swiper.activeIndex - 1) {
                slide.style.transition = 'all 0.6s ease';
                slide.style.opacity = '0.85';
                slide.style.transform = 'scale(0.9)';
                slide.style.filter = 'blur(0)';
                slide.style.zIndex = '5';
              } else {
                slide.style.transition = 'all 0.6s ease';
                slide.style.opacity = '0.6';
                slide.style.transform = 'scale(0.85)';
                slide.style.filter = 'blur(1px)';
                slide.style.zIndex = '0';
              }
            });
          });
          
          // Força a atualização periódica para manter o carrossel funcionando
          setInterval(() => {
            if (featureSwiper.swiper && isElementVisible(featureSwiper)) {
              featureSwiper.swiper.update();
              if (featureSwiper.swiper.autoplay && featureSwiper.swiper.autoplay.paused) {
                featureSwiper.swiper.autoplay.start();
              }
              
              // Verifica se o último slide está visível e retorna para o primeiro
              if (featureSwiper.swiper.isEnd) {
                setTimeout(() => {
                  featureSwiper.swiper.slideTo(0, 800, true);
                }, 200);
              }
            }
          }, 3000);
        }
      }
      
      // Configurar o carrossel após um pequeno atraso para garantir carregamento
      setTimeout(setupFeatureCarousel, 1000);
      
      // Adiciona tratamento de eventos touch para melhorar responsividade em dispositivos móveis
      document.querySelectorAll('.init-swiper').forEach(function(swiperElement) {
        swiperElement.addEventListener('touchstart', function() {
          if (swiperElement.swiper) {
            swiperElement.swiper.update();
          }
        }, { passive: true });
      });
      
      // Função auxiliar para verificar se um elemento está visível
      function isElementVisible(el) {
        if (!el) return false;
        const rect = el.getBoundingClientRect();
        const windowHeight = window.innerHeight || document.documentElement.clientHeight;
        return (
          rect.top <= windowHeight &&
          rect.bottom >= 0
        );
      }
      
      // Inicializador com atraso para garantir carregamento completo
      setTimeout(() => {
        const featuresSwiper = document.querySelector('.feature-swiper');
        if (featuresSwiper && featuresSwiper.swiper) {
          featuresSwiper.swiper.update();
          featuresSwiper.swiper.autoplay.start();
          
          // Adiciona classe personalizada para ativar efeitos visuais específicos
          featuresSwiper.classList.add('feature-swiper-initialized');
        }
      }, 1000);
      
      // Tratamento específico para tema verde 
      document.querySelectorAll('.btn-primary, .badge-primary, .badge-info').forEach(element => {
        element.style.backgroundColor = '#42b983';
        element.style.borderColor = '#42b983';
      });
    });
  </script>

</body>

</html>